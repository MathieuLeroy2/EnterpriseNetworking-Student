# Kopieer dit bestand naar .env en vervang alle CHANGE_ME-waarden.
# Neem .env nooit op in je verslag of repository.

PG_DB=authentik
PG_USER=authentik
PG_PASS=CHANGE_ME_RANDOM_DATABASE_PASSWORD
AUTHENTIK_SECRET_KEY=CHANGE_ME_RANDOM_AUTHENTIK_SECRET

AUTHENTIK_TAG=2026.5.3
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# Vul deze twee waarden pas in nadat je de OIDC-provider in Authentik hebt gemaakt.
OIDC_CLIENT_ID=CHANGE_ME_AFTER_PROVIDER_CREATION
OIDC_CLIENT_SECRET=CHANGE_ME_AFTER_PROVIDER_CREATION

